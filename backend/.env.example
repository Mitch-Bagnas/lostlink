# Server Environment
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL Connection Pooler - Transaction Mode port 6543 or Session Mode port 5432)
# Replace [PROJECT-REF] and [YOUR-PASSWORD] with your actual Supabase project credentials
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Authentication Secret (Use a secure random 32+ character string in production)
JWT_SECRET=lostlink-dev-jwt-secret-replace-with-32-chars-in-prod

# Frontend Origin for CORS & Secure Cookie Attribution
# Local: http://localhost:5173 | Prod: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Email Service (Resend)
# Optional in dev (falls back to console log preview). In production, set your Resend API key.
# Note on Resend Free Tier: Can only send to the email address registered on your Resend account.
RESEND_API_KEY=
EMAIL_FROM=LostLink <onboarding@resend.dev>
